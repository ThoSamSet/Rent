{
  "content": "<!-- Locations Content -->\n    <section class=\"locations-map-section home-section\" data-reveal>\n        <div class=\"locations-content\">\n            <div class=\"locations-intro\">\n                <p class=\"home-section__label\">Kanto</p>\n                <h2 class=\"home-section__title\">Bãi camping chúng mình hay đưa khách</h2>\n                <p class=\"locations-intro__text\">\n                    <span class=\"no-break\">Camp Nhà Thỏ</span> chọn lọc những bãi camping đẹp quanh Kanto — từ Phú Sĩ, biển đến Kanagawa, Saitama và Bắc Kanto. Chọn vùng bên dưới rồi xem vị trí các bãi trên bản đồ.\n                </p>\n            </div>\n\n            <section class=\"locations-regions home-section\" data-reveal aria-labelledby=\"location-filter-heading\">\n                    <p class=\"home-section__label\">Khu vực</p>\n                    <h2 id=\"location-filter-heading\" class=\"home-section__title\">Chọn vùng khám phá</h2>\n                    <div class=\"locations-filters\">\n                        <div class=\"locations-regions__grid\" role=\"group\" aria-labelledby=\"location-filter-heading\">\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card locations-region__card--featured\" data-filter-tag=\"phu-si\" aria-pressed=\"false\">\n                            <img src=\"/images/location-fumotoppara.webp\" alt=\"Camping vùng Phú Sĩ\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Phú Sĩ</span>\n                        </button>\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card\" data-filter-tag=\"bien\" aria-pressed=\"false\">\n                            <img src=\"/images/location-koganezaki.webp\" alt=\"Camping gần biển\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Biển</span>\n                        </button>\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card\" data-filter-tag=\"kanagawa\" aria-pressed=\"false\">\n                            <img src=\"/images/location-aone.webp\" alt=\"Camping Kanagawa\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Kanagawa</span>\n                        </button>\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card\" data-filter-tag=\"saitama\" aria-pressed=\"false\">\n                            <img src=\"/images/location-nagatoro-auto-campground.webp\" alt=\"Camping Saitama\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Saitama</span>\n                        </button>\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card\" data-filter-tag=\"bac-kanto\" aria-pressed=\"false\">\n                            <img src=\"/images/location-recamp-ashikaga.webp\" alt=\"Camping Recamp Ashikaga, Bắc Kanto\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Bắc Kanto</span>\n                        </button>\n                        </div>\n                    </div>\n                </section>\n\n            <section class=\"locations-map-band\" id=\"locations-map-band\" aria-label=\"Bản đồ các bãi camping\">\n                <header class=\"locations-map-band__header\">\n                    <p class=\"home-section__label\">Bản đồ</p>\n                    <h2 class=\"home-section__title\">Các bãi trên Kanto</h2>\n                    <p class=\"locations-map-band__teaser\">Chấm đen đánh dấu vị trí các bãi camping trên bản đồ.</p>\n                    <div class=\"locations-filters locations-filters--secondary\">\n                        <div class=\"location-filter-scroll\" role=\"group\" aria-label=\"Lọc theo vùng\">\n                            <button type=\"button\" class=\"filter-tag-btn filter-clear is-active\" data-filter-action=\"clear\" aria-pressed=\"true\">Tất cả</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"phu-si\" aria-pressed=\"false\">Phú Sĩ</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"bien\" aria-pressed=\"false\">Biển</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"kanagawa\" aria-pressed=\"false\">Kanagawa</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"saitama\" aria-pressed=\"false\">Saitama</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"bac-kanto\" aria-pressed=\"false\">Bắc Kanto</button>\n                        </div>\n                    </div>\n                </header>\n                <div id=\"locations-map-panel\" class=\"locations-map-panel\">\n                    <div class=\"map-container locations-map-band__map\">\n                        <div id=\"map\"></div>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </section>\n\n    <section class=\"home-bottom about-explore\" data-reveal aria-label=\"Tìm hiểu thêm\">\n                <a href=\"/schedule\" class=\"home-faq\">\n                    <div class=\"home-faq__media\">\n                        <img src=\"/images/subBanner-lich-trinh.webp\" alt=\"Lịch trình camping — kiểm tra lịch trống sắp tới\" width=\"640\" height=\"360\" loading=\"lazy\" decoding=\"async\">\n                    </div>\n                    <div class=\"home-faq__copy\">\n                        <p class=\"home-section__label\">Lịch trình</p>\n                        <h2 class=\"home-section__title\">Kiểm tra lịch trống sắp tới</h2>\n                    </div>\n                </a>\n                <a href=\"/pricing\" class=\"home-faq\">\n                    <div class=\"home-faq__media\">\n                        <img src=\"/images/chi-phi-1.webp\" alt=\"Chi phí và plan camping\" width=\"640\" height=\"360\" loading=\"lazy\" decoding=\"async\">\n                    </div>\n                    <div class=\"home-faq__copy\">\n                        <p class=\"home-section__label\">Chi phí</p>\n                        <h2 class=\"home-section__title\">Bảng giá &amp; plan</h2>\n                    </div>\n                </a>\n                <a href=\"/faq\" class=\"home-faq about-explore__full\">\n                    <div class=\"home-faq__media\">\n                        <img src=\"/images/subBanner-faq.webp\" alt=\"Câu hỏi thường gặp\" width=\"640\" height=\"360\" loading=\"lazy\" decoding=\"async\">\n                    </div>\n                    <div class=\"home-faq__copy\">\n                        <p class=\"home-section__label\">FAQ</p>\n                        <h2 class=\"home-section__title\">Câu hỏi thường gặp</h2>\n                    </div>\n                </a>\n            </section>",
  "inlineStyles": "<style></style>"
}
