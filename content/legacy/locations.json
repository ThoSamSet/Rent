{
  "content": "<!-- Locations Content -->\n    <section class=\"locations-map-section home-section\" data-reveal>\n        <div class=\"locations-content\">\n            <div class=\"locations-intro\">\n                <p class=\"home-section__label\">Kanto</p>\n                <h2 class=\"home-section__title\">Bãi camping chúng mình hay đưa khách</h2>\n                <p class=\"locations-intro__text\">\n                    <span class=\"no-break\">Camp Nhà Thỏ</span> chọn lọc những bãi camping đẹp quanh Kanto — từ Phú Sĩ, biển đến Kanagawa, Saitama và Bắc Kanto. Chọn vùng bên dưới rồi xem vị trí các bãi trên bản đồ.\n                </p>\n            </div>\n\n            <section class=\"locations-regions home-section\" data-reveal aria-labelledby=\"location-filter-heading\">\n                    <p class=\"home-section__label\">Khu vực</p>\n                    <h2 id=\"location-filter-heading\" class=\"home-section__title\">Chọn vùng khám phá</h2>\n                    <div class=\"locations-filters\">\n                        <div class=\"locations-regions__grid\" role=\"group\" aria-labelledby=\"location-filter-heading\">\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card locations-region__card--featured\" data-filter-tag=\"phu-si\" aria-pressed=\"false\">\n                            <img src=\"/images/location-fumotoppara.webp\" alt=\"Camping vùng Phú Sĩ\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Phú Sĩ</span>\n                        </button>\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card\" data-filter-tag=\"bien\" aria-pressed=\"false\">\n                            <img src=\"/images/location-koganezaki.webp\" alt=\"Camping gần biển\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Biển</span>\n                        </button>\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card\" data-filter-tag=\"kanagawa\" aria-pressed=\"false\">\n                            <img src=\"/images/location-aone.webp\" alt=\"Camping Kanagawa\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Kanagawa</span>\n                        </button>\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card\" data-filter-tag=\"saitama\" aria-pressed=\"false\">\n                            <img src=\"/images/location-nagatoro-auto-campground.webp\" alt=\"Camping Saitama\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Saitama</span>\n                        </button>\n                        <button type=\"button\" class=\"filter-tag-btn locations-region__card\" data-filter-tag=\"bac-kanto\" aria-pressed=\"false\">\n                            <img src=\"/images/location-recamp-ashikaga.webp\" alt=\"Camping Recamp Ashikaga, Bắc Kanto\" width=\"800\" height=\"600\" loading=\"eager\" decoding=\"async\">\n                            <span class=\"locations-region__label\">Bắc Kanto</span>\n                        </button>\n                        </div>\n                    </div>\n                </section>\n\n            <section class=\"locations-map-band\" id=\"locations-map-band\" aria-label=\"Bản đồ các bãi camping\">\n                <header class=\"locations-map-band__header\">\n                    <p class=\"home-section__label\">Bản đồ</p>\n                    <h2 class=\"home-section__title\">Các bãi trên Kanto</h2>\n                    <p class=\"locations-map-band__teaser\">Chấm đen đánh dấu vị trí các bãi camping trên bản đồ.</p>\n                    <div class=\"locations-filters locations-filters--secondary\">\n                        <div class=\"location-filter-scroll\" role=\"group\" aria-label=\"Lọc theo vùng\">\n                            <button type=\"button\" class=\"filter-tag-btn filter-clear is-active\" data-filter-action=\"clear\" aria-pressed=\"true\">Tất cả</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"phu-si\" aria-pressed=\"false\">Phú Sĩ</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"bien\" aria-pressed=\"false\">Biển</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"kanagawa\" aria-pressed=\"false\">Kanagawa</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"saitama\" aria-pressed=\"false\">Saitama</button>\n                    <button type=\"button\" class=\"filter-tag-btn\" data-filter-tag=\"bac-kanto\" aria-pressed=\"false\">Bắc Kanto</button>\n                        </div>\n                    </div>\n                </header>\n                <div id=\"locations-map-panel\" class=\"locations-map-panel\">\n                    <div class=\"map-container locations-map-band__map\">\n                        <div id=\"map\"></div>\n                    </div>\n                </div>\n            </section>\n\n            <section class=\"home-section home-gallery locations-gallery\" data-reveal aria-label=\"Ảnh các bãi camping\">\n                <div class=\"home-gallery__header locations-gallery__header\">\n                    <p class=\"home-section__label\">Gallery</p>\n                </div>\n                <div class=\"home-gallery__strip\" id=\"locations-gallery-strip\" tabindex=\"0\" aria-label=\"Ảnh camping theo khu vực — vuốt ngang để xem thêm\">\n                    <figure class=\"home-gallery__item\" data-region=\"phu-si\" data-site-id=\"fumotoppara\">\n                        <img src=\"/images/location-fumotoppara.webp\" alt=\"Fumotoppara Camping G