    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "html-validate": "^9.5.5",
    "postcss": "^8.5.28",
    "serve": "^14.2.4",
    "sharp": "^0.35.2",
