{
  "name": "campnhatho-rent",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup-fonts.js",
    "dev": "next dev",
    "lint": "npm run lint:js && npm run lint:next",
    "lint:js": "eslint lib/constants.js",
    "lint:html": "html-validate \"public/**/*.html\"",
    "lint:next": "eslint app/ components/ lib/",
    "build:assets": "node scripts/build.js",
    "process:images": "node scripts/process-source-images.js",
